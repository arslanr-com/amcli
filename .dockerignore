# The build stage needs the workspace and deploy/demo/, and nothing else.
# Everything left out here is either rebuilt inside the image or has no
# business being in a build context.

.git
.github
.gitattributes
.gitignore

# Rebuilt in the image; a host target/ is also the wrong architecture.
target/

# Documentation and media: the container serves a model, not the README.
# Anchored to the root on purpose. A bare `*.md` is top-level-only in Docker's
# matcher, but nothing about it says so, and `skills/amcli/SKILL.md` is
# `include_str!`d by skill.rs — the build fails outright if it goes missing.
/docs/
/*.md
/LICENSE
/NOTICE

# Anything a local run leaves behind.
*.archimate
*.svg
*.png
*.log
.env
.env.*
*.pem
*.key
.DS_Store
.idea/
.vscode/
